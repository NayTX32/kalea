# =============================================================
#  KALEASHOP — exemple de configuration PRODUCTION (hébergeur)
#  Copiez ce fichier en .env puis remplissez les cases « sync: false ».
#  URL publique du site : https://kaleashop.onrender.com
#  En production le serveur REFUSE de démarrer sans SESSION_SECRET,
#  et la porte /admin reste fermée sans ADMIN_GATE_PASSWORD.
# =============================================================

NODE_ENV=production
PORT=10000                            # Render impose 10000 (voir render.yaml)
# URL publique exacte (https), utilisée pour les retours de paiement,
# le callback Discord et le générateur d'URLs signées.
BASE_URL=https://kaleashop.onrender.com

# openssl rand -hex 32   (32+ octets aléatoires, ne jamais partager)
SESSION_SECRET=

# Base SQLite — sur un hébergeur, placez-la sur un disque PERSISTANT
# (le plan gratuit de Render réinitialise les données à chaque déploiement).
DATABASE_URL=data/kalea.db

# --- Paiements (auto : PayPal > Stripe > démo) ------------------
PAYMENT_PROVIDER=auto
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Discord OAuth2 (Developer Portal → OAuth2) -----------------
# Redirection à déclarer (EXACTEMENT) : https://kaleashop.onrender.com/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://kaleashop.onrender.com/callback
# En production le callback est servi par le même site → second port désactivé.
DISCORD_CALLBACK_PORT=0
# Bot « Kalea Manager » (lecture des membres et des rôles du serveur)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Rôle « Founder » du serveur → Administrateur du site (ID snowflake)
DISCORD_ROLE_FONDATEUR=
# Rôles attribués aux packs (peuvent être surchargés pack par pack)
DISCORD_ROLE_BASE=
DISCORD_ROLE_FULLLOCKER=
DISCORD_ROLE_MODER=

# --- API du jeu (livraison automatique signée HMAC) --------------
GAME_API_URL=
GAME_API_SECRET=
GAME_API_KEY=

# --- Comptes -----------------------------------------------------
ADMIN_EMAIL=admin@kalea.gg
ADMIN_PASSWORD=
# Porte d'accès /admin — OBLIGATOIRE : aucune valeur par défaut en production,
# laissé vide = la porte reste fermée (message d'erreur explicite).
ADMIN_GATE_PASSWORD=

# --- Sécurité ----------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10
RATE_LIMIT_API=240
SESSION_TTL=604800
# 1 = faire confiance à X-Forwarded-For (OBLIGATOIRE derrière Render/Caddy,
#     sans quoi toutes les limites de débit partagent la même IP).
TRUST_PROXY=true
# Délai (ms) avant revalidation serveur du rôle Discord « Founder »
ROLE_REVALIDATE_MS=300000
# Retirer automatiquement les récompenses et rôles en cas de remboursement
REMOVE_ROLE_ON_REFUND=true

# =============================================================
#  KALEA — exemple de configuration PRODUCTION (hébergeur)
#  Copiez ce fichier en .env puis remplissez les cases « sync: false ».
#  En production le serveur REFUSE de démarrer sans SESSION_SECRET.
# =============================================================

NODE_ENV=production
PORT=4000
# URL publique exacte (https), utilisée pour les retours de paiement
# et le callback Discord.
BASE_URL=https://votre-domaine.com

# openssl rand -hex 32   (32+ octets aléatoires, ne jamais partager)
SESSION_SECRET=

# Base SQLite — sur un hébergeur, placez-la sur un disque PERSISTANT.
DATABASE_URL=data/kalea.db

# --- Paiements (auto : PayPal > Stripe > démo) ------------------
PAYMENT_PROVIDER=auto
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Discord OAuth2 (Developer Portal → OAuth2) -----------------
# Redirection à déclarer : https://votre-domaine.com/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://votre-domaine.com/api/auth/discord/callback
# Bot (attribution automatique des rôles)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ROLE_BASE=
DISCORD_ROLE_FULLLOCKER=
DISCORD_ROLE_MODER=

# --- API du jeu (livraison automatique signée HMAC) --------------
GAME_API_URL=
GAME_API_SECRET=
GAME_API_KEY=

# --- Comptes -----------------------------------------------------
ADMIN_EMAIL=admin@kalea.gg
ADMIN_PASSWORD=
# Porte d'accès /admin — à CHANGER avant la mise en ligne
ADMIN_GATE_PASSWORD=

# --- Sécurité ----------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10
RATE_LIMIT_API=240
SESSION_TTL=604800

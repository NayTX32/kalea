# =============================================================
#  KALEASHOP — Configuration (.env)
#  Copier ce fichier en ".env" puis renseigner les valeurs.
#  Aucune donnée confidentielle n'est jamais exposée au navigateur.
#
#  ── MISE EN LIGNE (site public « kaleashop ») ─────────────────
#  URL publique : https://kaleashop.onrender.com   (voir MISE-EN-LIGNE.md)
#  1. Copier ce fichier en ".env" sur la machine / l'hébergeur.
#  2. Renseigner au minimum :
#       NODE_ENV=production
#       BASE_URL=https://kaleashop.onrender.com
#       SESSION_SECRET=<openssl rand -hex 32>       (OBLIGATOIRE en production)
#       DISCORD_REDIRECT_URI=https://kaleashop.onrender.com/callback
#       DISCORD_CALLBACK_PORT=0                     (callback servi par le même site)
#       TRUST_PROXY=1                               (derrière Render / reverse-proxy)
#       ADMIN_EMAIL=…  ADMIN_PASSWORD=<mot de passe fort>
#     En local, garder les valeurs par défaut de ce fichier.
#  3. Déclarer la même redirection URI exactement chez Discord
#     (https://discord.com/developers/applications → OAuth2 → Redirects).
#  4. Servir le site en HTTPS (obligatoire pour OAuth2 et les cookies sécurisés).
#  5. Fichiers d'accompagnement : README.md, MISE-EN-LIGNE.md,
#     .env.example, render.yaml, Dockerfile.
# =============================================================

# --- Général ---------------------------------------------------
# development = local | production = mise en ligne (HTTPS)
NODE_ENV=development
PORT=4000
# URL publique utilisée pour les redirections (OAuth, webhooks, paiements)
#   Local  : http://localhost:4000
#   Prod   : https://kaleashop.onrender.com   (ou https://www.votre-domaine.fr)
BASE_URL=http://localhost:4000
# Clé secrète de session (OBLIGATOIRE en production) : openssl rand -hex 32
SESSION_SECRET=

# --- Base de données -------------------------------------------
DATABASE_URL=data/kalea.db

# --- Prestataire de paiement -----------------------------------
# auto  = Stripe si les clés sont présentes, sinon mode démo
# stripe= Stripe obligatoire
# demo  = prestataire simulé (tests de bout en bout, webhook inclus)
PAYMENT_PROVIDER=auto
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Dev only : accepte "pm_card_visa" etc. sans 3DS réelle
STRIPE_TEST_MODE=true

# --- Prestataire de paiement : PayPal (portefeuille + carte) ------------------
# Créer les identifiants sur https://developer.paypal.com (App & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox = tests | live = production
PAYPAL_MODE=sandbox

# --- Discord OAuth2 + Bot --------------------------------------
# Sans identifiants : la "Connexion Discord" bascule en mode démonstration
# (écran d'autorisation local, 100 % hors-ligne). Avec les identifiants :
# vrai OAuth2 (voir DISCORD_REDIRECT_URI ci-dessous).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Redirection OAuth (doit correspondre EXACTEMENT à celle déclarée chez Discord)
#   Local : http://localhost:4200/callback
#   Prod  : https://kaleashop.onrender.com/callback   (même hôte que BASE_URL)
DISCORD_REDIRECT_URI=http://localhost:4200/callback
# Second port d'écoute du site qui reçoit ce callback
#   Local : 4200 (le site reste sur 4000)  —  Prod : 0 (désactivé, callback sur BASE_URL)
DISCORD_CALLBACK_PORT=4200
# Rôles par défaut (peuvent être surchargés pack par pack dans le dashboard)
DISCORD_ROLE_BASE=
DISCORD_ROLE_FULLLOCKER=
DISCORD_ROLE_MODER=
# Rôle Discord qui ouvre les privilèges ADMINISTRATEUR sur le site
#   · nom exact (ex. Fondateur) : nécessite DISCORD_BOT_TOKEN (le bot convertit les IDs en noms)
#   · ou ID du rôle (ex. 123456789012345678) : fonctionne aussi avec le simple OAuth2
# Vérification 100 % côté serveur à la connexion, puis toutes les
# ROLE_REVALIDATE_MS ms sur chaque route d'administration.
DISCORD_ROLE_FOUNDATEUR=Fondateur
# Retirer automatiquement le rôle Discord en cas de remboursement
REMOVE_ROLE_ON_REFUND=true

# --- API du jeu ------------------------------------------------
# URL de l'API du serveur de jeu (livraison des récompenses)
GAME_API_URL=
# Clé secrète utilisée pour signer les requêtes envoyées au jeu
GAME_API_SECRET=
# Clé d'API reçue par KaleaShop pour les requêtes entrantes du jeu
GAME_API_KEY=
# true = bloquer la commande en "livraison en attente" si le jeu est injoignable
GAME_API_REQUIRED=false

# --- Compte administrateur initial -----------------------------
# Créé automatiquement au premier démarrage s'il n'existe pas
ADMIN_EMAIL=admin@kalea.gg
ADMIN_PASSWORD=
# Mot de passe unique de la porte d'accès /admin (saisie d'un seul champ)
# → OBLIGATOIRE en production : aucune valeur par défaut n'est livrée avec le
#   code. En local, la valeur de développement par défaut s'applique si laissé vide ;
#   sur une URL publique, laissé vide = porte /admin fermée en permanence.
# → À CHANGER impérativement avant la mise en ligne (voir .env.production.example).
ADMIN_GATE_PASSWORD=

# --- Sécurité --------------------------------------------------
RATE_LIMIT_ENABLED=true
# Connexions / minute par IP
RATE_LIMIT_AUTH=10
# Requêtes API / minute par IP
RATE_LIMIT_API=240
# Cookies de session (secondes)
SESSION_TTL=604800
# 1 = faire confiance à X-Forwarded-For (OBLIGATOIRE derrière Render / Caddy,
#     et à mettre à 0 quand le site est exposé directement sur Internet)
TRUST_PROXY=1
# Délai (ms) avant revalidation serveur du rôle Discord "Fondateur"
# (5 minutes par défaut ; sur chaque route d'administration au-delà)
ROLE_REVALIDATE_MS=300000
